# =============================================================================
# Kiểm Kho — environment profiles (pick one)
# =============================================================================
#
# LOCAL POSTGRES (recommended for dev):
#   cp env/local.env is not needed — use:  npm run dev:local
#   First time: npm run setup:local && npm run dev:local
#
# SUPABASE CLOUD:
#   cp env/cloud.env.example env/cloud.env   # fill in your keys
#   npm run dev:cloud
#
# IN-MEMORY MOCK (no database):
#   npm run dev:mock
#
# =============================================================================

# --- Profile: choose ONE approach via npm script (dev:local / dev:cloud / dev:mock) ---
# Or copy values into .env.local for plain `npm run dev`

NEXT_PUBLIC_USE_MOCK_DB=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
