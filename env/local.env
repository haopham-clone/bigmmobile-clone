# Local PostgreSQL via Supabase CLI (Docker)
# Same API as cloud — switch env file to change target DB.
#
# Usage: npm run dev:local

NEXT_PUBLIC_USE_MOCK_DB=false

# Default keys from `supabase start` (same for every local install)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
